# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: how hard the agent thinks (low | medium | high | xhigh | max). Default: medium
AGENT_EFFORT=medium

# Lock the app with a code (strongly recommended before sharing a public link)
ACCESS_CODE=

# Max agent runs per IP address per hour (best effort, in memory). 0 = no limit. Default: 5
MAX_RUNS_PER_HOUR=5
