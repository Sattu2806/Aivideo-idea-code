# =====================================================================
# Pick ONE AI provider. Fill in its section; leave the others empty.
# If several are filled in, AI_PROVIDER decides; otherwise the first
# configured one wins in this order: Claude → Claude on Azure → Gemini → Azure OpenAI.
# =====================================================================

# Force a provider: anthropic | foundry | gemini | azure-openai   (optional)
AI_PROVIDER=

# --- Gemini (free key: https://aistudio.google.com/apikey) -----------
GEMINI_API_KEY=
# Optional. Default gemini-3.5-flash. Use any model your key can access.
GEMINI_MODEL=
# Set to true if your key is on a paid plan (hides the "free tier" label).
GEMINI_PAID=

# --- Claude (Anthropic API: https://platform.claude.com/settings/keys) --
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5-5
CLAUDE_MODEL=

# --- Claude on Azure (Microsoft Foundry) -----------------------------
ANTHROPIC_FOUNDRY_API_KEY=
# Your Foundry resource name (or set ANTHROPIC_FOUNDRY_BASE_URL instead)
ANTHROPIC_FOUNDRY_RESOURCE=
# Your Claude deployment name. Default claude-opus-5-5
FOUNDRY_MODEL=

# --- Azure OpenAI (GPT) ----------------------------------------------
# e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Your deployment name, e.g. gpt-4.1 or gpt-5
AZURE_OPENAI_DEPLOYMENT=
# Optional. Default 2025-04-01-preview
AZURE_OPENAI_API_VERSION=

# =====================================================================
# Web search for Gemini / Azure OpenAI (Claude has its own built in).
# Default: Tavily if TAVILY_API_KEY is set, else Gemini's Google Search
# if GEMINI_API_KEY is set, else DuckDuckGo (no key, but less reliable).
# =====================================================================
# tavily | gemini | duckduckgo   (optional)
SEARCH_PROVIDER=
# Free tier at https://tavily.com (1,000 searches a month)
TAVILY_API_KEY=

# =====================================================================
# Agent + sharing settings
# =====================================================================
# Claude only: how hard it thinks (low | medium | high | xhigh | max). Default medium
AGENT_EFFORT=

# Lock the app with a code (strongly recommended before sharing a public link)
ACCESS_CODE=

# Max agent runs per IP address per hour (best effort, in memory). 0 = no limit. Default 5
MAX_RUNS_PER_HOUR=5

# =====================================================================
# Watch mode (scheduled re-checks)
# =====================================================================
# Protects /api/watch/cron. Vercel Cron sends it automatically when set in Vercel.
CRON_SECRET=
# Required on Vercel (its file system doesn't persist). Free at https://upstash.com
# Leave empty on your own computer: the watchlist is saved in ./.data
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: Slack or Discord webhook, posted when a re-check finds changes
WATCH_WEBHOOK_URL=
# How many due watches one cron call runs (keeps it inside time limits). Default 2
WATCH_RUNS_PER_CRON=
